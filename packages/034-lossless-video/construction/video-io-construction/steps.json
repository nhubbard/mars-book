{
  "steps": [
    {
      "id": "s37",
      "region": "io_admit",
      "checkpoint": "io_admitted",
      "recipe": "s37-1",
      "quiz": {
        "id": "video-s37-q1",
        "question": "What should an invalid capacity do?",
        "choices": [
          {
            "id": "A",
            "text": "Return before opening the file."
          },
          {
            "id": "B",
            "text": "Open and immediately close it."
          },
          {
            "id": "C",
            "text": "Read one byte to discover its size."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s37-h1",
          "text": "Keep the capacity comparison unsigned and full-width."
        },
        {
          "id": "video-s37-h2",
          "text": "The early-return status is already initialized."
        }
      ]
    },
    {
      "id": "s38",
      "region": "io_state",
      "checkpoint": "io_state_ready",
      "recipe": "s38-1",
      "quiz": {
        "id": "video-s38-q1",
        "question": "What does the running transferred count describe?",
        "choices": [
          {
            "id": "A",
            "text": "The descriptor number."
          },
          {
            "id": "B",
            "text": "The accumulated bytes stored in the buffer."
          },
          {
            "id": "C",
            "text": "The number of frame records."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s38-h1",
          "text": "Keep persistent values out of syscall argument registers."
        },
        {
          "id": "video-s38-h2",
          "text": "Do not write the result context during setup."
        }
      ]
    },
    {
      "id": "s39",
      "region": "io_open",
      "checkpoint": "io_open_ready",
      "recipe": "s39-1",
      "quiz": {
        "id": "video-s39-q1",
        "question": "Which descriptor must later reads use?",
        "choices": [
          {
            "id": "A",
            "text": "Always three."
          },
          {
            "id": "B",
            "text": "The filename address."
          },
          {
            "id": "C",
            "text": "The handle returned by open."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s39-h1",
          "text": "A failed open must not enter the owned cleanup path."
        },
        {
          "id": "video-s39-h2",
          "text": "Keep the descriptor in a saved register."
        }
      ]
    },
    {
      "id": "s40",
      "region": "io_request",
      "checkpoint": "io_request_ready",
      "recipe": "s40-1",
      "quiz": {
        "id": "video-s40-q1",
        "question": "Why is this read request never zero?",
        "choices": [
          {
            "id": "A",
            "text": "A full buffer takes the separate probe path."
          },
          {
            "id": "B",
            "text": "Zero-length reads always report errors."
          },
          {
            "id": "C",
            "text": "The file header guarantees a large file."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s40-h1",
          "text": "Compare progress with capacity before forming a request."
        },
        {
          "id": "video-s40-h2",
          "text": "The destination is base plus accumulated bytes."
        }
      ]
    },
    {
      "id": "s41",
      "region": "io_result",
      "checkpoint": "io_progress_ready",
      "recipe": "s41-1",
      "quiz": {
        "id": "video-s41-q1",
        "question": "After a short positive read, what happens next?",
        "choices": [
          {
            "id": "A",
            "text": "Declare EOF immediately."
          },
          {
            "id": "B",
            "text": "Advance by the returned count and read again."
          },
          {
            "id": "C",
            "text": "Advance by the requested count."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s41-h1",
          "text": "Test the signed service result before adding it."
        },
        {
          "id": "video-s41-h2",
          "text": "A positive short read is still progress."
        }
      ]
    },
    {
      "id": "s42",
      "region": "io_probe",
      "checkpoint": "io_probe_ready",
      "recipe": "s42-1",
      "quiz": {
        "id": "video-s42-q1",
        "question": "Where is the extra-byte probe stored?",
        "choices": [
          {
            "id": "A",
            "text": "At destination plus capacity."
          },
          {
            "id": "B",
            "text": "In the published count field."
          },
          {
            "id": "C",
            "text": "In private stack storage."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s42-h1",
          "text": "A zero-byte request cannot establish EOF."
        },
        {
          "id": "video-s42-h2",
          "text": "A negative probe result is a failure."
        }
      ]
    },
    {
      "id": "s43",
      "region": "io_eof",
      "checkpoint": "io_eof_ready",
      "recipe": "s43-1",
      "quiz": {
        "id": "video-s43-q1",
        "question": "Does a successful load prove MLV1 validity?",
        "choices": [
          {
            "id": "A",
            "text": "No; the indexer checks the format afterward."
          },
          {
            "id": "B",
            "text": "Yes, because the bytes were read through EOF."
          },
          {
            "id": "C",
            "text": "Yes, if the filename ends in .mlv."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s43-h1",
          "text": "Only the loader count is tested at this layer."
        },
        {
          "id": "video-s43-h2",
          "text": "Keep success in a saved value until after closing."
        }
      ]
    },
    {
      "id": "s44",
      "region": "io_close",
      "checkpoint": "io_close_ready",
      "recipe": "s44-1",
      "quiz": {
        "id": "video-s44-q1",
        "question": "What stores the intended result while closing?",
        "choices": [
          {
            "id": "A",
            "text": "The close service number."
          },
          {
            "id": "B",
            "text": "The saved logical status."
          },
          {
            "id": "C",
            "text": "The filename suffix."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s44-h1",
          "text": "Close exactly the handle acquired by this call."
        },
        {
          "id": "video-s44-h2",
          "text": "Do not close after a failed open."
        }
      ]
    },
    {
      "id": "s45",
      "region": "io_publish",
      "checkpoint": "io_published",
      "recipe": "s45-1",
      "quiz": {
        "id": "video-s45-q1",
        "question": "When may the caller invoke the indexer?",
        "choices": [
          {
            "id": "A",
            "text": "After any nonnegative read."
          },
          {
            "id": "B",
            "text": "Before the EOF probe."
          },
          {
            "id": "C",
            "text": "After successful completed loading."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s45-h1",
          "text": "Publish only the loaded-count field."
        },
        {
          "id": "video-s45-h2",
          "text": "Do not pair an old directory with overwritten staging bytes."
        }
      ]
    }
  ]
}
