{
  "formatVersion": 1,
  "version": "0.1.0",
  "status": "draft",
  "audience": "Students with basic programming knowledge learning assembly",
  "environment": {
    "isa": "MIPS64 Release 6",
    "syscallAbi": "MARS educational",
    "jdk": "25",
    "ide": "IntelliJ IDEA 2026.3",
    "upstreamCommit": "f5eb7bdb90b1928ae55c07ecf9062b897ea8c995",
    "memoryLayout": "Default",
    "byteOrder": "little-endian",
    "graderRequirements": [
      "callFunction",
      "traceMemoryAccesses",
      "readDataAddress",
      "readBytes(address,length)",
      "runUntil",
      "provideFiles(writablePaths,maxWriteSize,failWriteAfterBytes,maxFileSize)",
      "FileAccessCheck.expectFile",
      "FileAccess.Operation.WRITE"
    ]
  },
  "modes": [
    "guided",
    "free-writing"
  ],
  "progression": {
    "default": "recommended-order",
    "instructorControls": [
      "require-quiz",
      "require-check",
      "hint-availability",
      "allow-skip",
      "allow-mode-switch"
    ],
    "localImplementation": "Native prose and public intermediate/final CLI checks; remote delivery and enforced instructor policies remain pending"
  },
  "id": "029-binary-ppm",
  "title": "Read and write a binary PPM image",
  "entry": "starter/main.asm",
  "assignment": "assignment.md",
  "reading": "reading.json",
  "prerequisites": [
    "Unsigned byte operations, shifts, packed words and full-width pointers",
    "Nested calls, saved registers and private storage",
    "File descriptors, short transfers and failure handling"
  ],
  "learningObjectives": [
    "Separate ASCII header tokens from uninterpreted raster bytes",
    "Bound a header scan and prove the exact raster extent",
    "Convert RGB triplets to display words and back",
    "Serialize dimensions into a canonical decimal header",
    "Handle short file operations, EOF and descriptor cleanup",
    "Validate before publishing metadata or truncating output"
  ],
  "inputDomain": {
    "type": "local-binary-ppm",
    "magic": "P6",
    "maximumDimension": 64,
    "maximumHeaderBytes": 256,
    "maximumFileBytes": 12544,
    "maximumPixels": 4096,
    "maxval": 255,
    "finalSeparator": "One LF after Maxval",
    "numericTokens": "Canonical positive decimal, no leading zeros",
    "extent": "Exactly one raster, no trailing bytes",
    "byteOrder": "little-endian",
    "overlap": "Disjoint input and output objects"
  },
  "steps": [
    {
      "id": "s01",
      "title": "Trace the header and raster",
      "kind": "observe",
      "quiz": {
        "id": "q01",
        "prompt": "Which offset begins the worked raster?",
        "choices": [
          {
            "id": "a",
            "text": "Twelve."
          },
          {
            "id": "b",
            "text": "Ten."
          },
          {
            "id": "c",
            "text": "Eleven."
          }
        ]
      },
      "hints": [
        {
          "id": "s01-h1",
          "text": "Count literal byte codes, not the printed escape characters."
        },
        {
          "id": "s01-h2",
          "text": "Each displayed backslash-n denotes one LF byte."
        }
      ],
      "content": "steps/01.md",
      "prerequisites": [],
      "completion": {
        "type": "learner-confirmation"
      }
    },
    {
      "id": "s02",
      "title": "Reject impossible byte counts",
      "kind": "author",
      "quiz": {
        "id": "q02",
        "prompt": "Which check comes before a header load?",
        "choices": [
          {
            "id": "a",
            "text": "The unsigned byte-count bound."
          },
          {
            "id": "b",
            "text": "The framebuffer color check."
          },
          {
            "id": "c",
            "text": "The destination filename."
          }
        ]
      },
      "hints": [
        {
          "id": "s02-h1",
          "text": "A pointer can be unusable even when the count is already enough to reject a request."
        },
        {
          "id": "s02-h2",
          "text": "Use the full count register; do not truncate it to a word before comparing."
        }
      ],
      "content": "steps/02.md",
      "prerequisites": [
        "s01"
      ],
      "editTarget": "p_bound",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s02.kts"
      }
    },
    {
      "id": "s03",
      "title": "Check the two magic bytes",
      "kind": "author",
      "quiz": {
        "id": "q03",
        "prompt": "What identifies this raw image subset?",
        "choices": [
          {
            "id": "a",
            "text": "The first RGB triplet."
          },
          {
            "id": "b",
            "text": "The ASCII bytes P and 6."
          },
          {
            "id": "c",
            "text": "A numerical word containing six."
          }
        ]
      },
      "hints": [
        {
          "id": "s03-h1",
          "text": "The magic has two bytes and no endianness-dependent word interpretation."
        },
        {
          "id": "s03-h2",
          "text": "Compare each loaded byte with its ASCII code."
        }
      ],
      "content": "steps/03.md",
      "prerequisites": [
        "s02"
      ],
      "editTarget": "p_magic",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s03.kts"
      }
    },
    {
      "id": "s04",
      "title": "Bound the header cursor",
      "kind": "author",
      "quiz": {
        "id": "q04",
        "prompt": "Which value limits a header load?",
        "choices": [
          {
            "id": "a",
            "text": "The framebuffer byte size."
          },
          {
            "id": "b",
            "text": "The final output filename length."
          },
          {
            "id": "c",
            "text": "The smaller of count and 256."
          }
        ]
      },
      "hints": [
        {
          "id": "s04-h1",
          "text": "A complete raster does not permit the header scanner to wander through it."
        },
        {
          "id": "s04-h2",
          "text": "Keep a separate header limit and test offset below it before loading."
        }
      ],
      "content": "steps/04.md",
      "prerequisites": [
        "s03"
      ],
      "editTarget": "p_state",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s04.kts"
      }
    },
    {
      "id": "s05",
      "title": "Classify the next gap byte",
      "kind": "author",
      "quiz": {
        "id": "q05",
        "prompt": "Does finding a separator also consume it?",
        "choices": [
          {
            "id": "a",
            "text": "Every header load advances automatically."
          },
          {
            "id": "b",
            "text": "Only the whitespace state advances across it."
          },
          {
            "id": "c",
            "text": "The raster loop consumes it later."
          }
        ]
      },
      "hints": [
        {
          "id": "s05-h1",
          "text": "Classification and cursor movement are different operations."
        },
        {
          "id": "s05-h2",
          "text": "Keep the current byte and offset intact when branching to its handling state."
        }
      ],
      "content": "steps/05.md",
      "prerequisites": [
        "s04"
      ],
      "editTarget": "p_gap",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s05.kts"
      }
    },
    {
      "id": "s06",
      "title": "Consume one whitespace byte",
      "kind": "author",
      "quiz": {
        "id": "q06",
        "prompt": "How far does this state advance?",
        "choices": [
          {
            "id": "a",
            "text": "One pixel row."
          },
          {
            "id": "b",
            "text": "One complete token."
          },
          {
            "id": "c",
            "text": "One byte per recognized separator."
          }
        ]
      },
      "hints": [
        {
          "id": "s06-h1",
          "text": "Repeated spaces need repeated transitions."
        },
        {
          "id": "s06-h2",
          "text": "Advance by one, then let the classifier decide whether another separator follows."
        }
      ],
      "content": "steps/06.md",
      "prerequisites": [
        "s05"
      ],
      "editTarget": "p_space",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s06.kts"
      }
    },
    {
      "id": "s07",
      "title": "Scan a comment within the same limit",
      "kind": "author",
      "quiz": {
        "id": "q07",
        "prompt": "What terminates this comment?",
        "choices": [
          {
            "id": "a",
            "text": "The next pixel sample."
          },
          {
            "id": "b",
            "text": "A zero byte anywhere in memory."
          },
          {
            "id": "c",
            "text": "A line feed within the header limit."
          }
        ]
      },
      "hints": [
        {
          "id": "s07-h1",
          "text": "A comment changes interpretation but does not expand the readable object."
        },
        {
          "id": "s07-h2",
          "text": "Test the bound on every iteration and retain LF for the whitespace transition."
        }
      ],
      "content": "steps/07.md",
      "prerequisites": [
        "s06"
      ],
      "editTarget": "p_comment",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s07.kts"
      }
    },
    {
      "id": "s08",
      "title": "Require a nonzero leading digit",
      "kind": "author",
      "quiz": {
        "id": "q08",
        "prompt": "Why exclude ASCII zero here?",
        "choices": [
          {
            "id": "a",
            "text": "Zero cannot occur in binary images."
          },
          {
            "id": "b",
            "text": "The framebuffer has no black pixels."
          },
          {
            "id": "c",
            "text": "The local tokens have no leading zeros and dimensions cannot be zero."
          }
        ]
      },
      "hints": [
        {
          "id": "s08-h1",
          "text": "The rule concerns the first digit, not all later digits."
        },
        {
          "id": "s08-h2",
          "text": "Check the leading byte before entering the general zero-through-nine digit loop."
        }
      ],
      "content": "steps/08.md",
      "prerequisites": [
        "s07"
      ],
      "editTarget": "p_leading",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s08.kts"
      }
    },
    {
      "id": "s09",
      "title": "Accumulate digits without consuming the delimiter",
      "kind": "author",
      "quiz": {
        "id": "q09",
        "prompt": "What does the digit loop leave for the next state?",
        "choices": [
          {
            "id": "a",
            "text": "The first nondigit at the current offset."
          },
          {
            "id": "b",
            "text": "The last digit at the previous offset."
          },
          {
            "id": "c",
            "text": "The first raster byte regardless of header length."
          }
        ]
      },
      "hints": [
        {
          "id": "s09-h1",
          "text": "An examined byte is not necessarily a consumed byte."
        },
        {
          "id": "s09-h2",
          "text": "Advance only after accepting a digit; branch away before advancing over a nondigit."
        }
      ],
      "content": "steps/09.md",
      "prerequisites": [
        "s08"
      ],
      "editTarget": "p_digits",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s09.kts"
      }
    },
    {
      "id": "s10",
      "title": "Retain width and height across tokens",
      "kind": "author",
      "quiz": {
        "id": "q10",
        "prompt": "Why retain both dimensions?",
        "choices": [
          {
            "id": "a",
            "text": "Their product gives the pixel count, and each also belongs in metadata."
          },
          {
            "id": "b",
            "text": "They are interchangeable byte offsets."
          },
          {
            "id": "c",
            "text": "Only their sum is needed."
          }
        ]
      },
      "hints": [
        {
          "id": "s10-h1",
          "text": "The same digit loop serves different fields, but their meanings persist."
        },
        {
          "id": "s10-h2",
          "text": "Use the field index to choose width, height or the final Maxval state."
        }
      ],
      "content": "steps/10.md",
      "prerequisites": [
        "s09"
      ],
      "editTarget": "p_dimensions",
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s10.kts"
      }
    },
    {
      "id": "s11",
