      "hints": [
        {
          "id": "s11-h1",
          "text": "Perform the extent comparison before the first metadata store."
        },
        {
          "id": "s11-h2",
          "text": "The validated offset permits subtraction without an unsigned underflow."
        }
      ],
      "content": "steps/11.md",
      "prerequisites": [
        "s10"
      ],
      "editTarget": "p_extent",
      "completion": {
        "type": "cli-grade",
