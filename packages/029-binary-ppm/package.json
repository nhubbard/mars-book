      "quiz": {
        "id": "q21",
        "prompt": "Does little-endian storage reverse the PPM component order?",
        "choices": [
          {
            "id": "a",
            "text": "No; it describes the stored word representation."
          },
          {
            "id": "b",
            "text": "Only for zero samples."
