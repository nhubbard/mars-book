  "id": "024-crc32",
  "title": "Check files with CRC-32",
  "entry": "starter/main.asm",
  "assignment": "assignment.md",
  "reading": "reading.json",
  "prerequisites": [
    "Raw byte intervals and unsigned word values",
    "Function frames, nested calls and explicit state",
    "Bounded parsing and caller-owned memory"
  ],
  "learningObjectives": [
    "Derive reflected CRC transitions and table entries",
    "Carry raw state across arbitrary read boundaries",
    "Keep initialization and finalization at message boundaries",
    "Handle short reads, EOF and read errors separately",
    "Release acquired descriptors on every return path",
    "Measure table setup separately from update work",
    "Reuse the CRC for PNG type and data bytes"
  ],
  "inputDomain": {
    "type": "reflected-crc32",
    "polynomial": "0xedb88320",
    "initialState": "0xffffffff",
    "finalXor": "0xffffffff",
    "maximumKernelBytes": 4096,
    "tableEntries": 256,
    "fileScratchMinimum": 1,
    "fileScratchMaximum": 256,
    "fileFixtureMaximumBytes": 4096
  },
  "steps": [
    {
      "id": "s01",
      "title": "Choose a raw-state boundary",
      "kind": "observe",
      "quiz": {
        "id": "q01",
        "prompt": "Which value continues the raw update?",
        "choices": [
          {
            "id": "a",
            "text": "The last returned raw state."
          },
          {
            "id": "b",
            "text": "The complemented display value."
          },
          {
            "id": "c",
            "text": "The byte count."
          }
        ]
      },
      "hints": [
        {
          "id": "s01-h1",
          "text": "Identify whether the message continues."
        },
        {
          "id": "s01-h2",
          "text": "Complement only when the complete message ends."
        }
      ],
      "content": "steps/01.md",
      "prerequisites": [],
      "completion": {
        "type": "learner-confirmation"
      }
    },
    {
      "id": "s02",
      "title": "Inspect the caller and safe temporary exits",
      "kind": "observe",
      "quiz": {
        "id": "q02",
        "prompt": "Does a provisional return establish a completed checksum?",
        "choices": [
          {
            "id": "a",
            "text": "Yes, when `v0` is zero."
          },
          {
            "id": "b",
            "text": "No; unfinished regions deliberately bypass work."
          },
          {
            "id": "c",
            "text": "Only when the table is mapped."
          }
        ]
      },
      "hints": [
        {
          "id": "s02-h1",
          "text": "Locate the next temporary branch."
        },
        {
          "id": "s02-h2",
          "text": "Read the file status before interpreting `v0`."
        }
      ],
      "content": "steps/02.md",
      "prerequisites": [
        "s01"
      ],
      "completion": {
        "type": "learner-confirmation"
      }
    },
    {
      "id": "s03",
