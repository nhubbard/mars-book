      "kind": "author",
      "quiz": {
        "id": "q03",
        "prompt": "Why load the mask outside the byte loop?",
        "choices": [
          {
            "id": "a",
            "text": "Its value changes at every bit."
          },
          {
            "id": "b",
            "text": "The same mask serves every byte."
          },
          {
            "id": "c",
            "text": "The pointer must equal the mask."
          }
        ]
      },
      "hints": [
        {
          "id": "s03-h1",
          "text": "Distinguish the mask from the current remainder."
        },
        {
          "id": "s03-h2",
          "text": "No input byte is read at this stage."
        }
      ],
      "editTarget": "b_setup",
      "content": "steps/03.md",
      "prerequisites": [
        "s02"
      ],
      "completion": {
        "type": "cli-grade",
        "check": "checks/construction/s03.kts"
      }
    },
