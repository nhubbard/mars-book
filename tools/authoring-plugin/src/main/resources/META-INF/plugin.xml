<idea-plugin>
  <id>edu.missouristate.mars.book.authoring</id>
  <name>MARS Book Authoring</name>
  <vendor>MARS book authors</vendor>
  <description>Authoring utilities for the MARS book. Installed separately from the student plugin.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends>edu.missouristate.mars</depends>
  <depends>training</depends>
  <extensions defaultExtensionNs="edu.missouristate.mars">
    <syscallEnvironmentCustomizer implementation="edu.missouristate.mars.book.BookFileFixtureCustomizer"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="edu.missouristate.mars.book.BookCaptureActivity"/>
  </extensions>
</idea-plugin>
