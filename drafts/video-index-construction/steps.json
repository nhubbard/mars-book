      "checkpoint": "index_entry_stored",
      "recipe": "s34-1",
      "quiz": {
        "id": "video-s34-q1",
        "question": "What value belongs in directory entry zero?",
        "choices": [
          {
            "id": "A",
            "text": "The absolute file pointer."
          },
          {
            "id": "B",
            "text": "The frame duration."
          },
          {
            "id": "C",
            "text": "The file-relative offset 24."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s34-h1",
          "text": "Each directory element occupies eight native bytes."
        },
        {
          "id": "video-s34-h2",
          "text": "The first eight arena bytes are a guard, outside the directory."
        }
      ]
    },
    {
