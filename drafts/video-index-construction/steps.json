{
  "steps": [
    {
      "id": "s24",
      "region": "index_admit",
      "checkpoint": "index_admitted",
      "recipe": "s24-1",
      "quiz": {
        "id": "video-s24-q1",
        "question": "What unit does the complete input count use?",
        "choices": [
          {
            "id": "A",
            "text": "Frames."
          },
          {
            "id": "B",
            "text": "Bytes including the global header."
          },
          {
            "id": "C",
            "text": "Directory entries."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s24-h1",
          "text": "Keep the count comparison unsigned and 64-bit."
        },
        {
          "id": "video-s24-h2",
          "text": "Load the large upper bound into a register."
        }
      ]
    },
    {
      "id": "s25",
      "region": "index_context",
      "checkpoint": "index_context_ready",
      "recipe": "s25-1",
      "quiz": {
        "id": "video-s25-q1",
        "question": "What may a rejected late record change?",
        "choices": [
          {
            "id": "A",
            "text": "The public directory."
          },
          {
            "id": "B",
            "text": "The published frame count."
          },
          {
            "id": "C",
            "text": "The active scratch image."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s25-h1",
          "text": "The scratch capacity is measured in bytes."
        },
        {
          "id": "video-s25-h2",
          "text": "Retain the admitted scratch pointer across nested calls."
        }
      ]
    },
    {
      "id": "s26",
      "region": "index_geometry",
      "checkpoint": "index_geometry_ready",
      "recipe": "s26-1",
      "quiz": {
        "id": "video-s26-q1",
        "question": "How are the width bytes interpreted?",
        "choices": [
          {
            "id": "A",
            "text": "As an unsigned big-endian integer."
          },
          {
            "id": "B",
            "text": "As native memory order."
          },
          {
            "id": "C",
            "text": "As a pixel address."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s26-h1",
          "text": "The version is included in the magic."
        },
        {
          "id": "video-s26-h2",
          "text": "Check width and height independently."
        }
      ]
    },
    {
      "id": "s27",
      "region": "index_schedule",
      "checkpoint": "index_schedule_ready",
      "recipe": "s27-1",
      "quiz": {
        "id": "video-s27-q1",
        "question": "What is the last sequence index in a 256-frame file?",
        "choices": [
          {
            "id": "A",
            "text": "256."
          },
          {
            "id": "B",
            "text": "255."
          },
          {
            "id": "C",
            "text": "257."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s27-h1",
          "text": "Distinguish a number of frames from an index."
        },
        {
          "id": "video-s27-h2",
          "text": "The period must be nonzero before remainder calculations."
        }
      ]
    },
    {
      "id": "s28",
      "region": "index_timing",
      "checkpoint": "index_timing_ready",
      "recipe": "s28-1",
      "quiz": {
        "id": "video-s28-q1",
        "question": "Does the indexer wait forty milliseconds per frame?",
        "choices": [
          {
            "id": "A",
            "text": "Yes, while checking its CRC."
          },
          {
            "id": "B",
            "text": "Yes, before each directory store."
          },
          {
            "id": "C",
            "text": "No; it only validates and retains the duration."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s28-h1",
          "text": "Duration is serialized big-endian but saved natively."
        },
        {
          "id": "video-s28-h2",
          "text": "Check the final reserved field separately."
        }
      ]
    },
    {
      "id": "s29",
      "region": "index_capacity",
      "checkpoint": "index_capacity_ready",
      "recipe": "s29-1",
      "quiz": {
        "id": "video-s29-q1",
        "question": "Which sequence belongs in the private context initially?",
        "choices": [
          {
            "id": "A",
            "text": "Zero."
          },
          {
            "id": "B",
            "text": "The number of frames."
          },
          {
            "id": "C",
            "text": "The file byte count."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s29-h1",
          "text": "Directory capacity is eight bytes per frame."
        },
        {
          "id": "video-s29-h2",
          "text": "The first nested call must expect record zero."
        }
      ]
    },
    {
      "id": "s30",
      "region": "index_window",
      "checkpoint": "index_window_ready",
      "recipe": "s30-1",
      "quiz": {
        "id": "video-s30-q1",
        "question": "Why check the outer record extent before calling its validator?",
        "choices": [
          {
            "id": "A",
            "text": "The CRC requires native alignment."
          },
          {
            "id": "B",
            "text": "The callee relies on the caller supplying a readable complete window."
          },
          {
            "id": "C",
            "text": "The header is always the last record."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s30-h1",
          "text": "Check sixteen header bytes before reading payload length."
        },
        {
          "id": "video-s30-h2",
          "text": "Compare the whole record size with remaining file bytes."
        }
      ]
    },
    {
      "id": "s31",
      "region": "index_validate",
      "checkpoint": "index_record_valid",
      "recipe": "s31-1",
      "quiz": {
        "id": "video-s31-q1",
        "question": "Which return address must the outer prologue preserve?",
        "choices": [
          {
            "id": "A",
            "text": "The checksum value."
          },
          {
            "id": "B",
            "text": "The next frame index."
          },
          {
            "id": "C",
            "text": "Its own caller's return address."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s31-h1",
          "text": "Reload the record length after a nested call if it is needed."
        },
        {
          "id": "video-s31-h2",
          "text": "The private context pointer is relative to the outer stack frame."
        }
      ]
    },
    {
      "id": "s32",
      "region": "index_advance",
      "checkpoint": "index_record_advanced",
      "recipe": "s32-1",
      "quiz": {
        "id": "video-s32-q1",
        "question": "What advances the byte offset?",
        "choices": [
          {
            "id": "A",
            "text": "The complete record byte count, including its header."
          },
          {
            "id": "B",
            "text": "One pixel."
          },
          {
            "id": "C",
            "text": "The number of frames."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s32-h1",
          "text": "The saved size already includes sixteen header bytes."
        },
        {
          "id": "video-s32-h2",
          "text": "Increment the record index separately."
        }
      ]
    },
    {
      "id": "s33",
      "region": "index_exact",
      "checkpoint": "index_file_valid",
      "recipe": "s33-1",
      "quiz": {
        "id": "video-s33-q1",
        "question": "Can a valid record prefix followed by one extra byte succeed?",
        "choices": [
          {
            "id": "A",
            "text": "Yes, if its CRCs match."
          },
          {
            "id": "B",
            "text": "No; the complete file must end exactly."
          },
          {
            "id": "C",
            "text": "Yes, if the byte is zero."
          }
        ]
      },
      "hints": [
        {
          "id": "video-s33-h1",
          "text": "Compare against the full supplied byte count."
        },
        {
          "id": "video-s33-h2",
          "text": "Do not begin public stores before this check."
        }
      ]
    },
    {
      "id": "s34",
